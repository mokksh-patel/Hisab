# ---------------------------------------------------------------------------
# BizPilot environment configuration (example)
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------
# Only the Supabase *publishable* (anon) key belongs in the browser bundle.
# It is safe to expose because every table is protected by Row Level Security.
# NEVER put the service-role key, database password or any other secret in a
# VITE_* variable: Vite inlines them into the public JavaScript bundle.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional: used only by local tooling / e2e tests, never by the app bundle.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_BASE_URL=http://localhost:5173
