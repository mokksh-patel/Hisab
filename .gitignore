# ===========================================================================
# BizPilot — .gitignore
#
# RULE: nothing containing a real credential may ever be committed.
# If you are unsure whether a file is safe, add it here first.
# ===========================================================================

# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Build output -----------------------------------------------------------
dist/
dist-ssr/
build/
*.tsbuildinfo

# --- Environment and secrets ------------------------------------------------
# Real credentials live ONLY in .env.local (or the host's env settings).
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets

# The example file is a template with placeholders only — safe to commit.
!.env.example

# --- Test output ------------------------------------------------------------
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
tests/e2e/.accounts.json

# --- Supabase local stack ---------------------------------------------------
supabase/.branches
supabase/.temp
supabase/.env
supabase/config.local.toml

# --- Backups ----------------------------------------------------------------
# Database exports must never enter version control.
backups/
*.dump
*.sql.gz
*.backup

# --- Editor / OS ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Misc -------------------------------------------------------------------
.cache/
tmp/
temp/
