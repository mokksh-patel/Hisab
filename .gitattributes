# Normalise line endings so the repository is consistent across platforms.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.dump binary
*.gz binary

# SQL and Markdown are diffed as text.
*.sql text eol=lf
*.md text eol=lf
